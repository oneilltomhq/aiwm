# Deepgram STT (speech-to-text)
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ElevenLabs TTS (text-to-speech)
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice ID (default: charlie - conversational Australian male)
# Browse voices at https://elevenlabs.io/app/voice-library
# ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD
